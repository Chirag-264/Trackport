# Required local configuration. Copy this file to backend/.env and replace the values.
PORT=5000
DB_URI=mongodb://127.0.0.1:27017/trackport
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# Keep "lax" for local development and same-site deployments. Set to "none" only
# when the browser frontend and API are on different sites; this requires HTTPS.
COOKIE_SAME_SITE=lax

# Optional integrations. Add OAuth callback URLs under /api/auth/{provider}/callback.
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
